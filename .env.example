# VIVAME Design — environment variables
# Copy this file to `.env.local` (for local dev) or set these as secrets/vars
# in your GitHub repository for CI builds. None of these are secrets.

# Public origin of the site (scheme://host, no trailing slash, no base path).
# Used for canonical URLs, Open Graph, sitemap, robots, and JSON-LD.
#   - GitHub Pages project site: https://USERNAME.github.io
#   - Custom domain:            https://your-domain.com
#   - Local dev (default):      http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base path when hosted under a sub-path (GitHub Pages project sites).
#   - GitHub Pages project site: /REPOSITORY_NAME
#   - Custom domain or user site: (empty)
NEXT_PUBLIC_BASE_PATH=
